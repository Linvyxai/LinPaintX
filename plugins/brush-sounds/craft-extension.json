{
  "schema": 1,
  "id": "io.github.artcraftandroid.brush-sounds",
  "name": "Звуки кисти",
  "version": "1.1.0",
  "holds": [
    "hooks"
  ],
  "publisher": {
    "name": "LinPaintX"
  },
  "description": "Звук при рисовании: ластик, карандаш, перо, кисть, аэрограф или баллончик — по кисти. Для любого можно импортировать свою запись. У кисти может быть свой звук в студии кисти.",
  "compat": {
    "procraft": {
      "interface": 1
    }
  },
  "permissions": [],
  "hooks": [
    "stroke_sound"
  ],
  "controls": [
    {
      "key": "volume",
      "type": "slider",
      "label": "Громкость",
      "least": 0,
      "most": 1,
      "step": 0.01,
      "starts": 1,
      "shown_times": 100,
      "unit": "%",
      "live": true
    },
    {
      "key": "sound",
      "type": "slider",
      "label": "Звук",
      "least": 0,
      "most": 6,
      "step": 1,
      "starts": 0,
      "names": [
        "По кисти",
        "Ластик",
        "Карандаш",
        "Перо",
        "Кисть",
        "Аэрограф",
        "Баллончик"
      ],
      "live": true
    },
    {
      "key": "eraser",
      "type": "switch",
      "label": "Звук при стирании",
      "starts": true
    },
    {
      "key": "eraser_sound",
      "type": "slider",
      "label": "Звук стирания",
      "least": 1,
      "most": 6,
      "step": 1,
      "starts": 1,
      "names": [
        "Ластик",
        "Карандаш",
        "Перо",
        "Кисть",
        "Аэрограф",
        "Баллончик"
      ],
      "live": true
    },
    {
      "key": "eraser_recording",
      "type": "file",
      "label": "Запись ластика",
      "accepts": "sound"
    },
    {
      "key": "pencil_recording",
      "type": "file",
      "label": "Запись карандаша",
      "accepts": "sound"
    },
    {
      "key": "pen_recording",
      "type": "file",
      "label": "Запись пера",
      "accepts": "sound"
    },
    {
      "key": "paintbrush_recording",
      "type": "file",
      "label": "Запись кисти",
      "accepts": "sound"
    },
    {
      "key": "airbrush_recording",
      "type": "file",
      "label": "Запись аэрографа",
      "accepts": "sound"
    },
    {
      "key": "spray_recording",
      "type": "file",
      "label": "Запись баллончика",
      "accepts": "sound"
    }
  ],
  "brush_controls": [
    {
      "key": "sound",
      "label": "Звук",
      "choices": [
        "Обычный",
        "Ластик",
        "Карандаш",
        "Перо",
        "Кисть",
        "Аэрограф",
        "Баллончик",
        "Без звука"
      ]
    }
  ]
}
