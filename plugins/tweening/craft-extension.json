{
  "schema": 1,
  "id": "io.github.artcraftandroid.tweening",
  "name": "Междукадровая анимация",
  "version": "1.1.0",
  "holds": [
    "hooks"
  ],
  "publisher": {
    "name": "LinPaintX"
  },
  "description": "В настройках кадра «Помощника анимации» появляется «Между»: кадр между текущим и следующим, с плавным сдвигом и смешиванием рисунков. Ещё нажатие — ещё кадр.",
  "compat": {
    "procraft": {
      "interface": 1
    }
  },
  "permissions": [],
  "hooks": [
    "inbetween"
  ],
  "controls": [
    {
      "key": "slide",
      "type": "switch",
      "label": "Сдвигать рисунки",
      "starts": true
    },
    {
      "key": "near",
      "type": "slider",
      "label": "Ближе к следующему кадру",
      "least": 0.1,
      "most": 0.9,
      "step": 0.05,
      "starts": 0.5,
      "shown_times": 100,
      "unit": "%"
    }
  ]
}
