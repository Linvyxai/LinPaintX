{
  "schema": 1,
  "id": "io.github.artcraftandroid.gap-closing",
  "name": "Замыкание промежутков ColorDrop",
  "version": "1.0.0",
  "holds": [
    "hooks"
  ],
  "publisher": {
    "name": "LinPaintX"
  },
  "description": "Не даёт заливке ColorDrop вытечь сквозь промежутки в линиях — до такой ширины.",
  "compat": {
    "procraft": {
      "interface": 1
    }
  },
  "permissions": [],
  "hooks": [
    "fill_mask"
  ],
  "controls": [
    {
      "key": "gap",
      "type": "slider",
      "label": "Промежуток",
      "least": 0,
      "most": 32,
      "step": 1,
      "starts": 0,
      "unit": " px",
      "at_least": "Off",
      "keeps": "fill_gap"
    }
  ]
}
