{
  "schema": 1,
  "id": "io.github.artcraftandroid.interface-colour",
  "name": "Цвет интерфейса",
  "version": "1.0.0",
  "holds": [
    "hooks"
  ],
  "publisher": {
    "name": "LinPaintX"
  },
  "description": "Синий цвет выбранного и включённого — свой собственный.",
  "compat": {
    "procraft": {
      "interface": 1
    }
  },
  "permissions": [],
  "hooks": [
    "interface_colour"
  ],
  "controls": [
    {
      "key": "hue",
      "type": "slider",
      "label": "Тон",
      "least": 0,
      "most": 360,
      "step": 1,
      "starts": 212,
      "unit": "°",
      "live": true
    },
    {
      "key": "saturation",
      "type": "slider",
      "label": "Насыщенность",
      "least": 0,
      "most": 1,
      "step": 0.01,
      "starts": 1,
      "shown_times": 100,
      "unit": "%",
      "live": true
    }
  ]
}
