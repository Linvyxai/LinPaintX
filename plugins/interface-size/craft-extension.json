{
  "schema": 1,
  "id": "io.github.artcraftandroid.interface-size",
  "name": "Размер интерфейса",
  "version": "1.0.0",
  "holds": [
    "hooks"
  ],
  "publisher": {
    "name": "LinPaintX"
  },
  "description": "Делает панели, кнопки и текст больше или меньше под ваш экран.",
  "compat": {
    "procraft": {
      "interface": 1
    }
  },
  "permissions": [],
  "hooks": [
    "interface_scale"
  ],
  "controls": [
    {
      "key": "size",
      "type": "slider",
      "label": "Размер",
      "least": 0.75,
      "most": 1.25,
      "step": 0.05,
      "starts": 1,
      "shown_times": 100,
      "unit": "%",
      "keeps": "interface_size"
    }
  ]
}
