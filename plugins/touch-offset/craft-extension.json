{
  "schema": 1,
  "id": "io.github.artcraftandroid.touch-offset",
  "name": "Смещение касания",
  "version": "1.0.0",
  "holds": [
    "hooks"
  ],
  "publisher": {
    "name": "LinPaintX"
  },
  "description": "Сдвигает место, где ложится штрих, — для пера, чьи чернила не под самым кончиком.",
  "compat": {
    "procraft": {
      "interface": 1
    }
  },
  "permissions": [],
  "hooks": [
    "position"
  ],
  "controls": [
    {
      "key": "x",
      "type": "slider",
      "label": "По горизонтали",
      "least": -100,
      "most": 100,
      "step": 1,
      "starts": 0,
      "unit": " px"
    },
    {
      "key": "y",
      "type": "slider",
      "label": "По вертикали",
      "least": -100,
      "most": 100,
      "step": 1,
      "starts": 0,
      "unit": " px"
    }
  ]
}
