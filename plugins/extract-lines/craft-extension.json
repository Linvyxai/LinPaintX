{
  "schema": 1,
  "id": "io.github.artcraftandroid.extract-lines",
  "name": "Извлечение линий",
  "version": "1.0.0",
  "holds": [
    "filter"
  ],
  "publisher": {
    "name": "LinPaintX"
  },
  "description": "Оставляет тёмные линии сканированного рисунка и убирает бумагу, чтобы можно было красить под ними.",
  "compat": {
    "procraft": {
      "interface": 1
    }
  },
  "permissions": [],
  "controls": [
    {
      "key": "cut",
      "type": "slider",
      "label": "Бумага",
      "least": 0,
      "most": 1,
      "step": 0.01,
      "starts": 0.15,
      "shown_times": 100,
      "unit": "%",
      "live": true
    },
    {
      "key": "soft",
      "type": "slider",
      "label": "Мягкость",
      "least": 0,
      "most": 0.5,
      "step": 0.01,
      "starts": 0.1,
      "shown_times": 100,
      "unit": "%",
      "live": true
    },
    {
      "key": "keep_colour",
      "type": "switch",
      "label": "Сохранять цвет",
      "starts": false
    }
  ]
}
